export async function placeOrder(cart: Cart, card: Card): Promise<OrderResult> {
  const charge = await gateway.charge(card, cart.total);
  if (charge.status !== "ok") {
    // BUG: we surface the raw gateway code instead of a friendly message,
    // and we never retry a soft decline (402) — the user just sees an error.
    return { ok: false, error: `Card was declined (code ${charge.code}).` };
  }
  return { ok: true, orderId: await orders.create(cart) };
}
        ]]></snippet>
